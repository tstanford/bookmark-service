meta {
  name: Login as user
  type: http
  seq: 14
}

post {
  url: {{serviceurl}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "username": "bob",
    "password": "password"
  }
}

script:post-response {
  bru.setVar("authToken", res.getBody()["authToken"])
}

settings {
  encodeUrl: true
  timeout: 0
}
